<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_order_form_global_tax" model="ir.ui.view">
            <field name="name">sale.order.form.global.tax</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//header" position="inside">
                    <button name="%(mobach_global_tax.action_mobach_global_tax_wizard)d"
                            string="Taxes Globales"
                            type="action"
                            class="btn-secondary"
                            invisible="state not in ('draft', 'sent')"/>
                    <button name="%(mobach_global_tax.action_mobach_global_tax_wizard)d"
                            string="Taxes Globales (Admin)"
                            type="action"
                            class="btn-warning"
                            invisible="state in ('draft', 'sent', 'cancel')"
                            groups="account.group_account_manager"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
