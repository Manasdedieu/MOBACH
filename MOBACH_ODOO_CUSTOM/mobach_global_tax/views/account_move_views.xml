<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_global_tax" model="ir.ui.view">
        <field name="name">account.move.form.global.tax</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@id='header_left_group']" position="inside">
                <field name="tax_type_use" invisible="1"/>
                <field name="global_tax_id"
                       readonly="state != 'draft'"
                       invisible="move_type not in ('out_invoice', 'out_refund', 'out_receipt', 'in_invoice', 'in_refund', 'in_receipt')"
                       options="{'no_create': True, 'no_open': True}"
                       placeholder="Sélectionner une taxe globale…"/>
                <field name="applied_global_tax_id" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
