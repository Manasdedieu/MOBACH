<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_move_form_global_tax" model="ir.ui.view">
            <field name="name">account.move.form.global.tax</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//header" position="inside">
                    <button name="%(mobach_global_tax.action_mobach_global_tax_wizard)d"
                            string="Taxes Globales"
                            type="action"
                            class="btn-secondary"
                            invisible="state != 'draft' or invoice_origin"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
