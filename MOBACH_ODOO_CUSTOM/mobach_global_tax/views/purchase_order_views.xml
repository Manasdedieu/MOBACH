<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_order_form_global_tax" model="ir.ui.view">
        <field name="name">purchase.order.form.global.tax</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="global_tax_id"
                       readonly="state in ('purchase', 'done', 'cancel')"
                       options="{'no_create': True, 'no_open': True}"
                       placeholder="Sélectionner une taxe globale…"/>
                <field name="applied_global_tax_id" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
