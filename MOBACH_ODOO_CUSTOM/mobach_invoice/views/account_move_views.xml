<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_currency_inherit" model="ir.ui.view">
        <field name="name">account.move.form.currency.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='currency_id']" position="after">
                <field name="ui_last_currency_id" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='tax_totals']" position="before">
                <field name="has_linked_order" invisible="1"/>
                <div class="float-end d-flex d-print-none gap-1 mb-2">
                    <button name="action_open_discount_wizard"
                            type="object"
                            string="Remise"
                            class="btn btn-secondary"
                            groups="sale.group_discount_per_so_line"
                            invisible="has_linked_order or state != 'draft' or move_type not in ('out_invoice', 'out_refund')"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
