<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_global_discount_inherit" model="ir.ui.view">
        <field name="name">sale.order.form.global.discount.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list" position="inside">
                <field name="is_global_discount_line" column_invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/form" position="inside">
                <field name="is_global_discount_line" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='tax_totals']" position="before">
                <field name="gross_untaxed_amount" invisible="1"/>
                <field name="global_discount_amount" invisible="1"/>
                <field name="net_untaxed_amount" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
