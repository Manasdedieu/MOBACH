<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_move_discount_form" model="ir.ui.view">
        <field name="name">account.move.discount.form</field>
        <field name="model">account.move.discount</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="company_id" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <div class="row">
                        <div class="col-sm-5 col-md-4 col-lg-4 col-4">
                            <group>
                                <label for="discount_amount" string="Remise" invisible="discount_type != 'amount'"/>
                                <field name="discount_amount" invisible="discount_type != 'amount'" nolabel="1"/>
                                <label for="discount_percentage" string="Remise" invisible="discount_type not in ('line_discount', 'global_discount')"/>
                                <field name="discount_percentage"
                                       invisible="discount_type not in ('line_discount', 'global_discount')"
                                       widget="percentage" nolabel="1"/>
                            </group>
                        </div>
                        <div class="col-sm-7 col-md-8 col-lg-8 col-8">
                            <field name="discount_type" widget="radio"/>
                        </div>
                    </div>
                </sheet>
                <footer>
                    <button name="action_apply_discount" string="Appliquer" type="object" class="btn btn-primary" data-hotkey="q"/>
                    <button string="Ignorer" class="btn btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
