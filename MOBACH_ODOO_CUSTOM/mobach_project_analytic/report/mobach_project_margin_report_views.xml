<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         TABLEAU CROISÉ DYNAMIQUE : CA / Dépenses / Marge par projet
    ================================================================ -->
    <!-- ================================================================
         TABLEAU CROISÉ DYNAMIQUE : CA / Dépenses / Marge par projet
    ================================================================ -->
    <record id="view_mobach_project_margin_report_pivot" model="ir.ui.view">
        <field name="name">mobach.project.margin.report.pivot</field>
        <field name="model">mobach.project.margin.report</field>
        <field name="arch" type="xml">
            <pivot string="Rentabilité par projet" sample="1">
                <field name="project_id" type="row"/>
                <field name="invoiced_revenue" type="measure"/>
                <field name="revenue" type="measure"/>
                <field name="customer_encours" type="measure"/>
                <field name="invoiced_expense" type="measure"/>
                <field name="expense" type="measure"/>
                <field name="vendor_encours" type="measure"/>
                <field name="margin" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- ================================================================
         GRAPHIQUE COMPARATIF : CA vs Dépenses vs Marge
    ================================================================ -->
    <record id="view_mobach_project_margin_report_graph" model="ir.ui.view">
        <field name="name">mobach.project.margin.report.graph</field>
        <field name="model">mobach.project.margin.report</field>
        <field name="arch" type="xml">
            <graph string="Rentabilité par projet" type="bar" sample="1">
                <field name="project_id"/>
                <field name="invoiced_revenue" type="measure"/>
                <field name="revenue" type="measure"/>
                <field name="customer_encours" type="measure"/>
                <field name="margin" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- ================================================================
         LISTE : le détail derrière les totaux
    ================================================================ -->
    <record id="view_mobach_project_margin_report_list" model="ir.ui.view">
        <field name="name">mobach.project.margin.report.list</field>
        <field name="model">mobach.project.margin.report</field>
        <field name="arch" type="xml">
            <list string="Rentabilité par projet" create="false" sample="1">
                <field name="date"/>
                <field name="project_id"/>
                <field name="move_id" optional="show"/>
                <field name="general_account_id" optional="show"/>
                <field name="partner_id" optional="hide"/>
                <field name="product_id" optional="hide"/>
                <field name="journal_id" optional="hide"/>
                <field name="nature" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="invoiced_revenue" sum="CA Facturé"/>
                <field name="revenue" sum="CA Encaissé"/>
                <field name="customer_encours" sum="Encours Client"
                       decoration-warning="customer_encours &gt; 0"/>
                <field name="invoiced_expense" sum="Dépenses Facturées" optional="hide"/>
                <field name="expense" sum="Dépenses Décaissées"/>
                <field name="vendor_encours" sum="Encours Fournisseur"
                       decoration-warning="vendor_encours &gt; 0"/>
                <field name="margin" sum="Marge Réalisée"
                       decoration-success="margin &gt; 0"
                       decoration-danger="margin &lt; 0"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- ================================================================
         RECHERCHE
    ================================================================ -->
    <record id="view_mobach_project_margin_report_search" model="ir.ui.view">
        <field name="name">mobach.project.margin.report.search</field>
        <field name="model">mobach.project.margin.report</field>
        <field name="arch" type="xml">
            <search string="Rentabilité par projet">
                <field name="project_id"/>
                <field name="project_partner_id"/>
                <field name="general_account_id"/>
                <field name="partner_id"/>
                <field name="move_id"/>

                <filter name="filter_revenue" string="Chiffre d'affaires"
                        domain="[('nature', '=', 'revenue')]"/>
                <filter name="filter_expense" string="Dépenses"
                        domain="[('nature', '=', 'expense')]"/>
                <separator/>
                <filter name="filter_operating" string="Exploitation seule"
                        domain="[('nature', '!=', 'other')]"
                        help="Écarte les comptes de bilan (TVA, tiers, banque) affectés à la main."/>
                <separator/>
                <filter name="filter_date" string="Date" date="date"/>
                <separator/>
                <filter name="filter_profitable" string="Projets rentables (marge &gt; 0)"
                        domain="[('margin', '&gt;', 0)]"/>
                <filter name="filter_loss" string="Projets déficitaires (marge &lt; 0)"
                        domain="[('margin', '&lt;', 0)]"/>

                <group>
                    <filter name="group_project" string="Projet"
                            context="{'group_by': 'project_id'}"/>
                    <filter name="group_project_partner" string="Client du projet"
                            context="{'group_by': 'project_partner_id'}"/>
                    <filter name="group_project_user" string="Chef de projet"
                            context="{'group_by': 'project_user_id'}"/>
                    <filter name="group_stage" string="Étape du projet"
                            context="{'group_by': 'stage_id'}"
                            groups="project.group_project_stages"/>
                    <filter name="group_nature" string="Nature"
                            context="{'group_by': 'nature'}"/>
                    <filter name="group_general_account" string="Compte général"
                            context="{'group_by': 'general_account_id'}"/>
                    <filter name="group_partner" string="Partenaire"
                            context="{'group_by': 'partner_id'}"/>
                    <filter name="group_journal" string="Journal"
                            context="{'group_by': 'journal_id'}"/>
                    <filter name="group_month" string="Mois"
                            context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ================================================================
         ACTION ET MENU
    ================================================================ -->
    <record id="action_mobach_project_margin_report" model="ir.actions.act_window">
        <field name="name">Rentabilité des Projets</field>
        <field name="res_model">mobach.project.margin.report</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="search_view_id" ref="view_mobach_project_margin_report_search"/>
        <field name="context">{'search_default_group_project': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucune écriture analytique imputée à un projet
            </p>
            <p>
                Le chiffre d'affaires et les dépenses remontent ici dès qu'une
                facture ou une écriture porte un « Projet analytique » sur ses
                lignes, et que la pièce est comptabilisée.
            </p>
        </field>
    </record>

    <!-- Deuxième des deux entrées de l'application Projet : voir
         views/project_menus.xml, qui pose la première et désactive les menus
         natifs. Le menu est accroché à la racine de l'application, pas sous
         « Analyse » qui n'existe plus.

         Les deux groupes reprennent exactement ceux du `ir.model.access.csv` :
         un menu visible sans droit de lecture n'ouvrirait qu'une erreur. -->
    <menuitem id="menu_mobach_project_margin_report"
              name="Rentabilité"
              parent="project.menu_main_pm"
              action="action_mobach_project_margin_report"
              groups="analytic.group_analytic_accounting,project.group_project_manager"
              sequence="2"/>

</odoo>
