    <!-- Bloc adresse natif (web.address_layout) : remplacé par les cadres MOBACH. -->
    <template id="address_layout_mobach" inherit_id="web.address_layout">
        <xpath expr="//div[@t-if='address']" position="attributes">
            <attribute name="t-if">address and not mobach_header</attribute>
        </xpath>
    </template>

    <!-- Documents qui utilisent l'en-tête MOBACH (même mécanisme que forced_vat :
         une variable posée dans le corps du t-call est visible dans le layout).
         Tout ce qui se trouve entre l'en-tête et le tableau des lignes est masqué :
         titre natif, bloc informations, titre et objet ajoutés par mobach_sale. -->
    <template id="report_saleorder_document_mobach_header" inherit_id="sale.report_saleorder_document">
        <xpath expr="//t[@t-call='web.external_layout']/t[@t-set='forced_vat']" position="after">
            <!-- Le pro-forma utilise le même document mais reste natif. -->
            <t t-set="mobach_header" t-value="not is_pro_forma"/>
            <t t-set="mobach_document_title" t-value="not is_pro_forma and 'BON DE COMMANDE'"/>
            <t t-set="mobach_doc" t-value="doc"/>
        </xpath>
        <xpath expr="//t[@t-set='layout_document_title']" position="after">
            <t t-if="mobach_header" t-set="layout_document_title" t-value="''"/>
        </xpath>
        <xpath expr="//h2[@id='informations']" position="attributes">
            <attribute name="t-if">not mobach_header</attribute>
        </xpath>
        <xpath expr="//span[@t-field='doc.object']/ancestor::div[hasclass('row')][1]" position="attributes">
            <attribute name="t-if">not mobach_header</attribute>
        </xpath>
        <!-- Numérotation des lignes de produit (colonne N°). -->
        <xpath expr="//th[@name='th_description']" position="before">
            <th t-if="mobach_header" name="th_mobach_line_number" class="text-start">N°</th>
        </xpath>
        <xpath expr="//tbody[hasclass('sale_tbody')]/t[@t-foreach='lines_to_report']" position="before">
            <t t-set="mobach_line_number" t-value="0"/>
        </xpath>
        <xpath expr="//td[@name='td_product_name']" position="before">
            <t t-if="mobach_header">
                <t t-set="mobach_line_number" t-value="mobach_line_number + 1"/>
                <td name="td_mobach_line_number"><t t-out="mobach_line_number"/></td>
            </t>
        </xpath>
        <xpath expr="//td[@name='td_section_name']" position="before">
            <td t-if="mobach_header"/>
        </xpath>
        <xpath expr="//td[@name='td_note_name']" position="before">
            <td t-if="mobach_header"/>
        </xpath>
        <xpath expr="//td[@name='td_combo_name']" position="before">
            <td t-if="mobach_header"/>
        </xpath>
        <xpath expr="//td[@name='td_section_group_name']" position="before">
            <td t-if="mobach_header"/>
        </xpath>
        <xpath expr="//div[@name='so_total_summary']" position="after">
            <t t-if="mobach_header" t-call="mobach_report_background.report_amount_in_words_mobach"/>
        </xpath>
        <!-- Conditions de paiement retirées. -->
        <xpath expr="//span[@t-field='doc.payment_term_id.note']/.." position="attributes">
            <attribute name="t-if">not mobach_header and not is_html_empty(doc.payment_term_id.note)</attribute>
        </xpath>
    </template>
    <template id="report_invoice_document_mobach_header" inherit_id="account.report_invoice_document">
        <xpath expr="//t[@t-call='web.external_layout']/t[@t-set='forced_vat']" position="after">
            <t t-set="mobach_header" t-value="True"/>
            <t t-set="mobach_document_title" t-value="'AVOIR' if o.move_type in ('out_refund', 'in_refund') else 'FACTURE'"/>
            <t t-set="mobach_doc" t-value="o"/>
        </xpath>
        <xpath expr="//t[@t-set='layout_document_title']" position="after">
            <t t-set="layout_document_title" t-value="''"/>
        </xpath>
        <xpath expr="//h2[@id='informations']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
        <xpath expr="//span[@t-field='o.object']/ancestor::div[hasclass('row')][1]" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
        <!-- Numérotation des lignes de produit (colonne N°). -->
        <xpath expr="//th[@name='th_description']" position="before">
            <th name="th_mobach_line_number" class="text-start"><span>N°</span></th>
        </xpath>
        <xpath expr="//tbody[hasclass('invoice_tbody')]/t[@t-foreach='lines_to_report']" position="before">
            <t t-set="mobach_line_number" t-value="0"/>
        </xpath>
        <xpath expr="//td[@name='account_invoice_line_name']" position="before">
            <t t-set="mobach_line_number" t-value="mobach_line_number + 1"/>
            <td name="td_mobach_line_number"><t t-out="mobach_line_number"/></td>
        </xpath>
        <xpath expr="//td[@name='line_name_td']" position="before">
            <td/>
        </xpath>
        <xpath expr="//t[@t-elif='is_note']/td" position="before">
            <td/>
        </xpath>
        <xpath expr="//td[@name='account_invoice_line_name_grouped_desktop']" position="before">
            <td name="td_mobach_line_number_grouped">
                <t t-if="hide_details or grouped_line['display_type'] == 'product'">
                    <t t-set="mobach_line_number" t-value="mobach_line_number + 1"/>
                    <t t-out="mobach_line_number"/>
                </t>
            </td>
        </xpath>
        <!-- Montant en lettres : le nôtre, sous les totaux, remplace celui d'Odoo. -->
        <xpath expr="//span[@t-field='o.amount_total_words']/ancestor::p[1]" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
        <xpath expr="//div[@id='payment_term']" position="before">
            <t t-call="mobach_report_background.report_amount_in_words_mobach"/>
        </xpath>
        <!-- Conditions de paiement (note et échéancier) retirées. -->
        <xpath expr="//span[@id='payment_terms_note_id']/.." position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
    </template>
</odoo>
