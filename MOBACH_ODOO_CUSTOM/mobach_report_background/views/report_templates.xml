<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- En-tête MOBACH : remplace l'en-tête du layout de la société (quel qu'il soit)
         uniquement quand le document définit mobach_header (devis et factures).
         Les autres rapports gardent l'en-tête natif de leur layout. -->
    <template id="report_header_mobach">
        <div class="row col-sm-12 ml-auto d-flex">
            <div style="width:50%;" class="m-0 ml-auto d-flex">
                <div name="company_address" class="m-0">
                    <ul class="list-unstyled" name="company_address_list">
                        <li t-if="company.is_company_details_empty"><span t-field="company.partner_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;], &quot;no_marker&quot;: true}">
                            <div class="bg-light border-1 rounded h-100 d-flex flex-column align-items-center justify-content-center w-100 opacity-75 text-muted text-center">
                                <strong>Company address block</strong>
                                <div>Contains the company address.</div>
                            </div>
                        </span></li>
                        <li t-else="">
                            <span t-field="company.company_details">
                                <div class="bg-light border-1 rounded h-100 d-flex flex-column align-items-center justify-content-center p-4 w-100 opacity-75 text-muted text-center">
                                    <strong>Company details block</strong>
                                    <div>Contains the company details.</div>
                                </div>
                            </span>
                        </li>
                        <li t-if="not forced_vat"/>
                        <li t-else="">
                            <t t-esc="company.country_id.vat_label or 'Tax ID'">Tax ID</t>:
                            <span t-esc="forced_vat">US12345671</span>
                        </li>
                    </ul>
                </div>
            </div>
            <div style="width:50%;text-align:right;background-color:#72302E;color:#fff;" class="p-3">
                <div style="font-size:12px;text-align:right">
                    <!-- nui est défini par mobach_config (pas une dépendance de ce module). -->
                    NUMERO CONTRIBUABLE: <span t-if="'nui' in company._fields" class="ms-1" t-field="company.nui">US12345671</span>
                </div>
                <div style="font-size:12px;text-align:right">
                    RCCM: <span>RC/MVR/23/B/125</span>
                </div>
            </div>
        </div>
    </template>

    <!-- Pied de page MOBACH : la pagination seule. -->
    <template id="report_footer_mobach">
        <div t-if="report_type == 'pdf'" class="text-center text-muted">
            Page <span class="page"/> / <span class="topage"/>
        </div>
    </template>

    <!-- Début du corps des devis / factures MOBACH, inséré avant tout le reste de l'article :
         titre encadré, OBJET, puis cadres client / informations du document.
         Tout ce que les documents affichaient entre l'en-tête et le tableau est masqué
         (voir les héritages en bas de fichier). -->
    <template id="report_document_title_mobach">
        <div class="text-center mb-3"
             style="width: 60%; margin-left: auto; margin-right: auto; padding: 8px 0; background-color: #eeeeee; border: 1px solid #d6d6d6; border-radius: 12px; color: #000; font-size: 20px; font-weight: bold; letter-spacing: 1px;">
            <t t-out="mobach_document_title"/>
            <t t-if="mobach_doc.name and mobach_doc.name != '/'" t-out="mobach_doc.name"/>
        </div>
        <t t-call="mobach_report_background.report_document_info_mobach"/>
    </template>

    <!-- mobach_doc : sale.order ou account.move. -->
    <template id="report_document_info_mobach">
        <t t-set="is_invoice" t-value="mobach_doc._name == 'account.move'"/>
        <t t-set="shipping" t-value="mobach_doc.partner_shipping_id"/>
        <!-- NUI / RCCM (mobach_sale), à défaut N° TVA / Company ID, portés par la société cliente. -->
        <t t-set="client" t-value="mobach_doc.partner_id.commercial_partner_id"/>
        <div class="row col-sm-12 ml-auto d-flex mb-3" style="font-size: 13px;">
            <!-- Client -->
            <div style="width: 48.5%; border: 1px solid #000; padding: 8px 10px;" name="mobach_partner_block">
                <div><strong>Doit :</strong> <span t-out="client.name"/></div>
                <div><strong>NUI :</strong> <span t-out="client.nui or client.vat"/></div>
                <div><strong>RCCM :</strong> <span t-out="client.rccm or client.company_registry"/></div>
                <div><strong>Tél :</strong> <span t-out="mobach_doc.partner_id.phone or client.phone"/></div>
                <div><strong>Email :</strong> <span t-out="mobach_doc.partner_id.email or client.email"/></div>
            </div>
            <!-- Informations du document (le numéro est dans le titre) -->
            <div style="width: 48.5%; margin-left: 3%; border: 1px solid #000; padding: 8px 10px;" name="mobach_document_block">
                <t t-if="is_invoice">
                    <div><strong>Date d'émission :</strong> <span t-field="mobach_doc.invoice_date"/></div>
                    <div><strong>Réf. PROFORMA :</strong> <span t-field="mobach_doc.ref"/></div>
                </t>
                <t t-else="">
                    <div><strong>Date d'émission :</strong> <span t-field="mobach_doc.date_order" t-options="{&quot;widget&quot;: &quot;date&quot;}"/></div>
                    <div><strong>Réf. PROFORMA :</strong> <span t-field="mobach_doc.client_order_ref"/></div>
                </t>
                <!-- Livraison : devis uniquement. -->
                <t t-if="not is_invoice">
                    <div><strong>Lieu de livraison :</strong> <span t-out="shipping.city"/></div>
                    <div class="d-flex">
                        <strong class="text-nowrap me-1">Adresse de livraison :</strong>
                        <span t-if="shipping" t-field="mobach_doc.partner_shipping_id"
                              t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;], &quot;no_marker&quot;: true}"/>
                    </div>
                </t>
            </div>
        </div>
        <div class="mb-2">
            <strong style="text-decoration: underline;">OBJET :</strong>
            <span class="ms-2" t-field="mobach_doc.object"/>
        </div>
    </template>

    <!-- Montant total en lettres, affiché sous les totaux (mobach_doc : sale.order ou account.move). -->
    <template id="report_amount_in_words_mobach">
        <div class="mt-3 mb-3" style="clear: both;" name="mobach_amount_in_words">
            <t t-if="mobach_doc._name == 'sale.order'">Arrêté le présent bon de commande à la somme de :</t>
            <t t-elif="mobach_doc.move_type in ('out_refund', 'in_refund')">Arrêté le présent avoir à la somme de :</t>
            <t t-else="">Arrêtée la présente facture à la somme de :</t>
            <!-- En français comme le reste du document, quelle que soit la langue du client. -->
            <strong t-out="mobach_doc.currency_id.with_context(lang='fr_FR').amount_to_text(mobach_doc.amount_total)"/>
        </div>
    </template>

    <!-- Aiguillage dans chaque external layout : en-tête / pied natifs ou MOBACH,
         et titre encadré en tête du corps. -->
    <template id="external_layout_standard_mobach_header" inherit_id="web.external_layout_standard">
        <xpath expr="//div[contains(concat(' ', @t-attf-class, ' '), ' header ')]" position="attributes">
            <attribute name="t-if">not mobach_header</attribute>
        </xpath>
        <xpath expr="//div[contains(concat(' ', @t-attf-class, ' '), ' header ')]" position="after">
            <div t-else="" t-attf-class="header o_company_#{company.id}_layout">
                <t t-call="mobach_report_background.report_header_mobach"/>
            </div>
        </xpath>
        <xpath expr="//div[contains(concat(' ', @t-attf-class, ' '), ' footer ')]" position="attributes">
            <attribute name="t-if">not mobach_header</attribute>
        </xpath>
        <xpath expr="//div[contains(concat(' ', @t-attf-class, ' '), ' footer ')]" position="after">
            <div t-else="" t-attf-class="footer o_company_#{company.id}_layout">
                <t t-call="mobach_report_background.report_footer_mobach"/>
            </div>
        </xpath>
        <xpath expr="//div[contains(concat(' ', @t-attf-class, ' '), ' article ')]/*[1]" position="before">
            <t t-if="mobach_document_title" t-call="mobach_report_background.report_document_title_mobach"/>
        </xpath>
    </template>
