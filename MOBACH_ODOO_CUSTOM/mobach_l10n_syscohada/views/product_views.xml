<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_template_form_view_immobilisation_account" model="ir.ui.view">
        <field name="name">product.template.form.immobilisation.account</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="account.product_template_form_view"/>
        <field name="arch" type="xml">
            <field name="property_account_expense_id" position="after">
                <field name="property_account_immobilisation_id"
                       invisible="accounting_nature != 'immobilisation'"/>
            </field>
        </field>
    </record>

    <record id="view_category_property_form_immobilisation_account" model="ir.ui.view">
        <field name="name">product.category.form.immobilisation.account</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="account.view_category_property_form"/>
        <field name="arch" type="xml">
            <field name="property_account_expense_categ_id" position="after">
                <field name="property_account_immobilisation_categ_id"/>
            </field>
        </field>
    </record>

</odoo>
