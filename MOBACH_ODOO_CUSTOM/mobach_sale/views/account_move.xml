<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form_account_move_objet" model="ir.ui.view">
        <field name="name">view_move.form.account.move.objet</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@id='header_left_group']/field[@name='quick_edit_total_amount']" position="before">
                <field name="object" required="1"/>
            </xpath>
        </field>
    </record>

    <!-- Nature comptable (charge / immobilisation) en surbrillance sur les lignes -->
    <record id="view_move_form_accounting_nature" model="ir.ui.view">
        <field name="name">account.move.form.accounting.nature</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='name']" position="after">
                <field name="accounting_nature" string="Nature" optional="show" widget="badge"
                       decoration-info="accounting_nature == 'charge'"
                       decoration-warning="accounting_nature == 'immobilisation'"/>
            </xpath>
        </field>
    </record>


</odoo>
