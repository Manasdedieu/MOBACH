        <field name="register_id" ref="contrib_register_dgi" />
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
brut = categories.GROSS
if brut &lt;= 50000:
    val = 0.0
elif brut &lt;= 100000:
    val = 750.0
elif brut &lt;= 200000:
    val = 1950.0
elif brut &lt;= 300000:
    val = 3250.0
elif brut &lt;= 400000:
    val = 4550.0
elif brut &lt;= 500000:
    val = 5850.0
elif brut &lt;= 600000:
    val = 7150.0
elif brut &lt;= 700000:
    val = 8450.0
elif brut &lt;= 800000:
    val = 9750.0
elif brut &lt;= 900000:
    val = 11050.0
elif brut &lt;= 100000:
    val = 12350.0
else:
    val = 13000.0
result = - val
        </field>
