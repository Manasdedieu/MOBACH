    <!-- SALAIRE BRUT -->
    <record id="rule_gross_cm" model="hr.salary.rule">
        <field name="name">SALAIRE BRUT</field>
        <field name="sequence" eval="50" />
        <field name="code">GROSS</field>
        <field name="category_id" ref="category_gross" />
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
result = categories.BASIC + categories.ALW
        </field>
        <field name="note">Total brut de tous les gains et indemnités</field>
    </record>

    <!-- SALAIRE BRUT TAXABLE -->
    <record id="rule_gross_tax_cm" model="hr.salary.rule">
        <field name="name">SALAIRE BRUT TAXABLE</field>
        <field name="sequence" eval="51" />
        <field name="code">GROSS_TAX</field>
        <field name="category_id" ref="category_info" />
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
# Représentation exonérée d'impôt au Cameroun (frais professionnels)
exo_rep = inputs.IND_REP.amount if inputs.IND_REP else 0.0
result = max(0.0, categories.BASIC + categories.ALW - exo_rep)
        </field>
        <field name="note">Base soumise à l'IRPP et au CFC</field>
    </record>

    <!-- SALAIRE COTISABLE -->
    <record id="rule_gross_cotis_cm" model="hr.salary.rule">
        <field name="name">SALAIRE COTISABLE</field>
        <field name="sequence" eval="52" />
        <field name="code">GROSS_COTIS</field>
        <field name="category_id" ref="category_info" />
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
# Représentation et transport exclus de l'assiette de cotisation CNPS
exo_rep = inputs.IND_REP.amount if inputs.IND_REP else 0.0
exo_trans = inputs.IND_TRANS.amount if inputs.IND_TRANS else 0.0
base = max(0.0, categories.BASIC + categories.ALW - exo_rep - exo_trans)
result = min(base, 750000.0)
        </field>
        <field name="note">Base cotisable CNPS (plafonné légalement à 750 000 FCFA)</field>
    </record>

