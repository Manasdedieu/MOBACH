    <!-- 1. SALAIRE DE BASE -->
    <record id="rule_basic_cm" model="hr.salary.rule">
        <field name="name">Salaire de base</field>
        <field name="sequence" eval="1" />
        <field name="code">BASIC</field>
        <field name="category_id" ref="category_basic" />
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
result = contract.wage
        </field>
        <field name="note">Salaire de base négocié sur le contrat</field>
    </record>

    <!-- 2. PRIME D'ACCUEIL ET D'ENTRETIEN -->
    <record id="rule_prime_acc_ent_cm" model="hr.salary.rule">
        <field name="name">Prime d'accueil et d'entretien</field>
        <field name="sequence" eval="2" />
        <field name="code">PRIME_ACC_ENT</field>
        <field name="category_id" ref="category_alw" />
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
result = inputs.PRIME_ACC_ENT.amount if inputs.PRIME_ACC_ENT else 0.0
        </field>
    </record>

    <!-- 3. PRIME D'ANCIENNETÉ -->
    <record id="rule_prime_anc_cm" model="hr.salary.rule">
        <field name="name">Prime d'ancienneté</field>
        <field name="sequence" eval="3" />
        <field name="code">ANC</field>
        <field name="category_id" ref="category_alw" />
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
start = contract.date_start
if start and payslip.date_to:
    years = (payslip.date_to - start).days // 365
    if years >= 2:
        rate = 0.04 + (years - 2) * 0.01
        result = contract.wage * rate
    else:
        result = 0.0
else:
    result = 0.0
        </field>
        <field name="note">Règle légale Cameroun : 4% après 2 ans, +1% par an supplémentaire</field>
    </record>

