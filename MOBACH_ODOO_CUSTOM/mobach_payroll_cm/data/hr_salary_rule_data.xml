    <!-- BASE IMPOSABLE IRPP (INTERMÉDIAIRE) -->
    <record id="rule_base_irpp_cm" model="hr.salary.rule">
        <field name="name">Base Nette Imposable IRPP</field>
        <field name="sequence" eval="90" />
        <field name="code">BASE_IRPP</field>
        <field name="category_id" ref="category_info" />
        <field name="appears_on_payslip" eval="False" />
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
brut = GROSS_TAX
if brut &lt;= 62000:
    result = 0.0
else:
    cnps_val = GROSS_COTIS * 0.042
    net_apres_cnps = brut - cnps_val
    net_apres_frais = net_apres_cnps * 0.70
    abattement_fixe = 500000.0 / 12.0
    result = max(0.0, net_apres_frais - abattement_fixe)
        </field>
    </record>

    <!-- IRPP -->
    <record id="rule_irpp_cm" model="hr.salary.rule">
        <field name="name">IRPP</field>
        <field name="sequence" eval="100" />
        <field name="code">IRPP</field>
        <field name="category_id" ref="category_ded" />
        <field name="register_id" ref="contrib_register_dgi" />
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
base_imp = BASE_IRPP
if base_imp &lt;= 0:
    irpp = 0.0
else:
    t1 = min(base_imp, 166667.0) * 0.10
    t2 = max(0.0, min(base_imp - 166667.0, 83333.0)) * 0.15
    t3 = max(0.0, min(base_imp - 250000.0, 166667.0)) * 0.25
    t4 = max(0.0, base_imp - 416667.0) * 0.35
    irpp = t1 + t2 + t3 + t4
result = - round(irpp)
        </field>
    </record>

    <!-- CENTIMES ADDITIONNELS -->
    <record id="rule_cac_cm" model="hr.salary.rule">
