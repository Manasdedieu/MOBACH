        <field name="name">Indemnité de salissure</field>
        <field name="code">IND_SALIS</field>
        <field name="input_id" ref="rule_ind_salis_cm" />
    </record>

    <record id="input_ind_panier" model="hr.rule.input">
        <field name="name">Indemnité de panier</field>
        <field name="code">IND_PANIER</field>
        <field name="input_id" ref="rule_ind_panier_cm" />
    </record>

    <record id="input_ind_lait" model="hr.rule.input">
        <field name="name">Indemnité de lait</field>
        <field name="code">IND_LAIT</field>
        <field name="input_id" ref="rule_ind_lait_cm" />
    </record>

    <record id="input_avance" model="hr.rule.input">
        <field name="name">Avances sur salaires</field>
        <field name="code">AVANCE</field>
        <field name="input_id" ref="rule_avance_cm" />
    </record>

    <record id="input_pret" model="hr.rule.input">
        <field name="name">Remboursement prêts - retenues</field>
        <field name="code">PRET</field>
        <field name="input_id" ref="rule_pret_cm" />
    </record>
</odoo>
