    <record id="input_ind_trans" model="hr.rule.input">
        <field name="name">Indemnité de transport</field>
        <field name="code">IND_TRANS</field>
        <field name="input_id" ref="rule_ind_trans_cm" />
    </record>

    <record id="input_ind_log" model="hr.rule.input">
        <field name="name">Indemnité de logement</field>
        <field name="code">IND_LOG</field>
        <field name="input_id" ref="rule_ind_log_cm" />
    </record>

    <record id="input_ind_eau" model="hr.rule.input">
        <field name="name">Indemnité d'eau</field>
        <field name="code">IND_EAU</field>
        <field name="input_id" ref="rule_ind_eau_cm" />
