<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <!-- Types d'entrées manuelles pour les bulletins de salaire (selon matrice MOBACH) -->
    <record id="input_prime_acc_ent" model="hr.rule.input">
        <field name="name">Prime d'accueil et d'entretien</field>
        <field name="code">PRIME_ACC_ENT</field>
        <field name="input_id" ref="rule_prime_acc_ent_cm" />
    </record>

    <record id="input_ind_conge" model="hr.rule.input">
        <field name="name">Indemnité de congé</field>
        <field name="code">IND_CONGE</field>
        <field name="input_id" ref="rule_ind_conge_cm" />
    </record>

    <record id="input_prime_resp" model="hr.rule.input">
        <field name="name">Prime de responsabilité</field>
        <field name="code">PRIME_RESP</field>
        <field name="input_id" ref="rule_prime_resp_cm" />
    </record>

    <record id="input_hs_20" model="hr.rule.input">
        <field name="name">Heures supplémentaires 20%</field>
        <field name="code">HS_20</field>
        <field name="input_id" ref="rule_hs_20_cm" />
    </record>

    <record id="input_h_abs" model="hr.rule.input">
        <field name="name">Heures d'absence</field>
        <field name="code">H_ABS</field>
        <field name="input_id" ref="rule_h_abs_cm" />
