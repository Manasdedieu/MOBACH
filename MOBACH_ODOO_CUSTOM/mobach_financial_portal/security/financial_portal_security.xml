<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- ================================================================
             GROUPE D'ACCÈS AU PORTAIL DE PERFORMANCE FINANCIÈRE
        ================================================================ -->
        <record id="group_financial_portal_user" model="res.groups">
            <field name="name">Performance Financière MOBACH : Accès Tableau de Bord</field>
            <field name="comment">Permet d'accéder au tableau de bord de performance financière (portail + configuration)</field>
            <field name="implied_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
        </record>

        <!-- ================================================================
             GROUPE PATRON DU GROUPE MOBACH
             Réservé au patron du groupe MOBACH pour afficher la synthèse
             globale de l'ensemble des sociétés.
        ================================================================ -->
        <record id="group_financial_portal_patron" model="res.groups">
            <field name="name">Performance Financière MOBACH : Patron du Groupe</field>
            <field name="comment">Réservé au patron du groupe MOBACH : permet de visualiser la synthèse globale de performance financière de toutes les sociétés du Groupe MOBACH sur le portail web.</field>
            <field name="implied_ids" eval="[(4, ref('group_financial_portal_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <!-- ================================================================
             CLOISONNEMENT MULTI-SOCIÉTÉ

             Sans cette règle, tout titulaire du groupe « Facturation » lisait les
             indicateurs financiers des quatre sociétés du groupe MOBACH, y compris
             celles auxquelles il n'est pas rattaché.
        ================================================================ -->
        <record id="financial_performance_company_rule" model="ir.rule">
            <field name="name">Performance Financière : cloisonnement par société</field>
            <field name="model_id" ref="model_mobach_financial_performance"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

    </data>
</odoo>
