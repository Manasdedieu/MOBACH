<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_payment_term_form_inherit_retenue" model="ir.ui.view">
        <field name="name">account.payment.term.form.inherit.retenue</field>
        <field name="model">account.payment.term</field>
        <field name="inherit_id" ref="account.view_payment_term_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group" position="inside">
                <group string="Retenue sur solde">
                    <field name="is_retenue"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
