<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vue Purchase Order -->
    <record id="purchase_order_form_currency_inherit" model="ir.ui.view">
        <field name="name">purchase.order.form.currency.inherit</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='currency_id']" position="after">
                <field name="ui_last_currency_id" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
